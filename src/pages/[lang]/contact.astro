---
export const prerender = true
export const getStaticPaths = () => [
	{ params: { lang: 'fr' } },
	{ params: { lang: 'en' } },
	{ params: { lang: 'es' } }
]
import ContactImg from '@/assets/imgs/contact.webp'
import { ContactForm } from '@/components/contact-form'
import MyImage from '@/components/my-image.astro'
import { createTranslator, I18n } from '@/i18n/translations'
import Layout from '@/layouts/layout.astro'
import { MDV_DEFAULT_ADDRESS, TELEPHONE_DEFAULT, toMetaDescription } from '@/utils/helper'

const locale = (Astro.params.lang || 'fr') as I18n
const t = createTranslator(locale)
---

<Layout title={t('NOUS_CONTACTER')} description={toMetaDescription(t('CONTACT_DESC'))}>
	<main id="main-content">
		<h1 class="sr-only">{t('NOUS_CONTACTER')}</h1>
		<section class="section-default">
			<article class="grid grid-cols-1 gap-10 lg:grid-cols-3 lg:gap-12">
				<div class="flex flex-col lg:col-span-2">
					<h2 class="text-primary pb-4 lg:pb-6">{t('NOUS_CONTACTER')}</h2>
					<p class="distinguished pb-8 lg:pb-12">{t('CONTACT_INTRO')}</p>
					<p class="whitespace-pre-line pb-8 lg:pb-12">{t('CONTACT_DESC')}</p>

					<address class="not-italic pb-8 lg:pb-12 flex flex-col gap-3">
						<a
							href={`tel:${TELEPHONE_DEFAULT.replace(/\s+/g, '')}`}
							class="distinguished inline-flex w-fit items-center gap-2 hover:underline"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
							</svg>
							{TELEPHONE_DEFAULT}
						</a>
						<span class="distinguished inline-flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" />
								<circle cx="12" cy="10" r="3" />
							</svg>
							{MDV_DEFAULT_ADDRESS}
						</span>
					</address>

					<ContactForm
						client:load
						locale={locale}
						apiBaseUrl={import.meta.env.PUBLIC_PAYLOAD_URL}
					/>
				</div>
				<div class="max-h-[400px] lg:max-h-none">
					<MyImage
						alt=""
						src={ContactImg}
						width={700}
						height={650}
						layout="fullWidth"
						class="h-full max-h-[400px] w-full rounded-2xl object-cover lg:max-h-none"
					/>
				</div>
			</article>
		</section>
	</main>
</Layout>
